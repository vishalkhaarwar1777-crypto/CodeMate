# Local development values. Copy this file to .env and fill in real values.
# Never commit real secrets.

PORT=3000
MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin(s) allowed by CORS. Comma separate multiple origins
# (for example a preview deployment plus the stable alias). The stable alias
# and this project's Vercel preview hostnames are allowed in app.js already;
# add any other origin (custom domain, extra local port) here.
FRONTEND_URL=http://localhost:5173

# Optional: only needed when the system DNS cannot resolve MongoDB Atlas SRV
# records. Leave unset to use the operating system resolver.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# On Render, set NODE_ENV=production and:
# FRONTEND_URL=https://codemates-connect.vercel.app
NODE_ENV=development
