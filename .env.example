# Local development values. Copy this file to .env and fill in real values.
# Never commit real secrets.

PORT=3000
MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=replace-with-a-long-random-secret

# Local frontend origin. CORS also allows this by default.
FRONTEND_URL=http://localhost:5173

# On Render, set NODE_ENV=production and:
# FRONTEND_URL=https://codemates-connect.vercel.app
NODE_ENV=development
